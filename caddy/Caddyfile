{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
		Cache-Control "no-store"
	}

	route {
		# 1. 认证端点（公开，免JWT）
		@auth path /auth/*
		handle @auth {
			reverse_proxy gemini-api:4981
		}

		# 2. 图片代理（公开，免JWT）
		@proxy path /proxy-image/*
		handle @proxy {
			reverse_proxy gemini-api:4981
		}

		# 3. PWA 静态资源
		@static path /manifest.webmanifest /favicon.svg /pwa-192.png /pwa-512.png
		handle @static {
			root * /srv/www
			file_server
		}

		# 4. 健康检查
		handle /health {
			reverse_proxy gemini-api:4981
		}

		# 5. API 反代（JWT由后端中间件验证）
		@api path /openai/* /claude/* /gemini/* /conversations /conversations/* /docs /openapi.json
		handle @api {
			reverse_proxy gemini-api:4981
		}

		# 6. SPA（JWT由后端中间件验证）
		handle {
			root * /srv/www
			try_files {path} /index.html
			file_server
		}
	}
}
