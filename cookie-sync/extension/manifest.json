{
  "manifest_version": 3,
  "name": "Gemini Gateway Cookie Sync",
  "version": "1.0.0",
  "description": "自动将本机 gemini.google.com 的登录 Cookie 同步到私人网关（仅本机回环）",
  "permissions": ["cookies", "alarms", "storage"],
  "host_permissions": [
    "https://gemini.google.com/*",
    "http://127.0.0.1:8799/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
