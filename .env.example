# ============================================================
# Gemini Web Gateway 配置模板
# 复制为 .env 后填写。.env 含敏感凭据，永远不要提交到 Git 或分享。
# cp .env.example .env
# ============================================================

# ===== Gemini 网页版会话（必填）=====
# 网关使用 Gemini 网页端的浏览器会话鉴权（非官方 API Key）。
# 获取：本机浏览器登录 gemini.google.com → F12 → Application → Cookies
#       复制 __Secure-1PSID 与 __Secure-1PSIDTS 两个 Cookie 的值。
# 安全提醒：会话 Cookie 等同于你的 Google 账号登录凭据，务必保密。
GEMINI_1PSID=
GEMINI_1PSIDTS=

# 完整 Google 登录 Cookie（可选，竖线 | 分隔多组 name=value）。
# 用于下载 Google CDN 生成的图片；不填则自动退回使用上面的 PSID。
GEMINI_GOOGLE_COOKIES=

# 会话保活刷新间隔（分钟）
GEMINI_REFRESH_INTERVAL=5

# 上游请求失败重试次数
GEMINI_MAX_RETRIES=3

# true = 无痕模式：对话不进入 gemini.google.com 的历史记录
GEMINI_TEMPORARY=false

# 官网模型别名（可选）：把官网模型选择器的动态令牌映射为友好名字
# 获取方法见 docs/capture-model-id.md；格式：名字=令牌,名字2=令牌2
GEMINI_MODEL_ALIASES=

# 调试开关（默认关闭）。true 时把生图请求/响应 dump 到 data/cookies/debug/
# 注意：dump 内容包含对话文本（Cookie 始终脱敏），仅用于排查问题，用完即关。
GEMINI_DEBUG=false

# ===== 用户系统（JWT + SQLite）=====
# JWT 签名密钥。生产环境必须显式设置（openssl rand -hex 32）。
# 留空时网关会自动生成随机密钥并持久化到数据目录。
GATEWAY_JWT_SECRET=
# JWT 有效期（天）
GATEWAY_JWT_EXPIRE_DAYS=30
# 注册邀请码。留空 = 任何能访问网关的人都可以注册，公网部署务必设置！
GATEWAY_INVITE_CODE=
# SQLite 数据库路径（容器内路径）
GATEWAY_DB_PATH=/data/gateway.db

# ===== 网络出口代理 =====
# Gemini Web 需要通过代理访问。默认值适配 OrbStack (macOS)：
#   host.docker.internal 上的 7890 端口（Clash 系列混合端口）
# Docker Desktop / Linux 请改为对应宿主机地址。
GATEWAY_PROXY_URL=http://host.docker.internal:7890

# ===== Cloudflare Tunnel（可选）=====
# 留空 = 不启用隧道，仅本机/局域网访问。
# 填入命名隧道 Token（Cloudflare Zero Trust → Networks → Tunnels）= 固定域名。
TUNNEL_TOKEN=

# ===== 限流（保护你的 Gemini 账号）=====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# ===== Cookie 自动同步扩展（可选）=====
# 配合 cookie-sync/ 浏览器扩展自动推送新 Cookie。
# 运行 scripts/install-cookie-sync.sh 会自动生成并写入 Token。
COOKIE_SYNC_TOKEN=
