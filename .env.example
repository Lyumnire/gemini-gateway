# ============================================
# Gemini Web Gateway 配置
# 复制为 .env 后填写；.env 含敏感信息，永远不要提交/分享
# ============================================

# ===== Gemini 网页版 Cookie（必填）=====
# 获取方式见 docs/deploy-guide.md 的「获取 Cookie」一节
# 在 Mac 浏览器登录 gemini.google.com 后，F12 → 应用(Application) → Cookie
# 复制 __Secure-1PSID 和 __Secure-1PSIDTS 的值
GEMINI_1PSID=
GEMINI_1PSIDTS=

# Cookie 自动轮换间隔（分钟），保持会话活跃
GEMINI_REFRESH_INTERVAL=30

# 上游请求失败重试次数
GEMINI_MAX_RETRIES=3

# true = 无痕模式：对话不会保存进你的 gemini.google.com 历史记录
GEMINI_TEMPORARY=false

# ===== 访问认证（必填，由 scripts/setup.sh 自动生成）=====
GATEWAY_USER=admin
# bcrypt 哈希，切勿手写；运行 scripts/setup.sh 生成或修改密码

# ===== 网络 =====
# 宿主机上 Clash Verge 的混合代理端口
GATEWAY_PROXY_URL=http://host.orb.internal:7897

# ===== Cloudflare Tunnel =====
# 留空 = 免费临时域名（xxxx.trycloudflare.com，隧道重启后地址会变）
# 填入命名隧道 Token = 固定域名，见 docs/deploy-guide.md「升级为固定域名」
TUNNEL_TOKEN=

# ===== 限流（保护你的 Gemini 账号）=====
RATE_LIMIT_MAX_REQUESTS=30
